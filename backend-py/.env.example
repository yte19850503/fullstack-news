# 环境变量模板 — 复制为 .env 后修改
# Docker 部署时不需要此文件，环境变量在 docker-compose.yml 中设置

# 数据库连接（本地开发用 localhost，Docker 内用 mysql）
DATABASE_URL=mysql+pymysql://news:news123@localhost:3306/news_db

# Redis 连接（本地开发用 localhost，Docker 内用 redis）
REDIS_URL=redis://localhost:6379

# JWT 密钥（生产环境必须换成随机长字符串）
JWT_SECRET=your-secret-key-change-this

# JWT 过期时间
JWT_EXPIRES_IN=7d

# CORS 允许的域名（逗号分隔，留空则使用默认 localhost 地址）
# CORS_ORIGINS=https://your-app.up.railway.app,https://admin.yourdomain.com
