# ============================================
# AI 资讯站 - 全局 Git 忽略规则
# ============================================

# 环境变量和密钥（绝对不能提交）
.env
.env.local
.env.*.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
*.db
*.sqlite3

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 构建输出
frontend/dist/
admin/dist/
frontend/.vite/
admin/.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Docker
docker-compose.override.yml

# 测试和覆盖率
coverage/
.nyc_output/
test-results/
playwright-report/

# 日志
*.log
logs/

# 临时文件
*.tmp
*.bak
*.cache
